{
    "require": {
        "twig/twig": "~2.4",
        "sentry/sdk": "~3.0",
        "php-http/curl-client": "~2.1",
        "php-http/async-client-implementation": "^1.0",
        "cache/memcached-adapter": "~1.0"
    },
    "config": {
        "policy": {
            "advisories": {
                "ignore": {
                    "twig/twig": "Twig 2 kept temporarily for the PHP 8.4 migration; Twig 3 upgrade is a follow-up"
                }
            }
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
